<div class="publications featured-publications">
  {% capture selected_publications %}
    {% bibliography --group_by none --query @*[selected=true]* %}
  {% endcapture %}
  {{ selected_publications | prioritize_publications: 'yuan2026peralperceptionaware,lee2025magperchamagnetically' }}
</div>

